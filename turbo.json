{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                ".next/**",
                "dist/**",
                "build/**"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "env": [
                "DATABASE_URL",
                "JWT_SECRET",
                "NEXTAUTH_SECRET",
                "NEXTAUTH_URL",
                "NODE_ENV"
            ]
        }
    }
}